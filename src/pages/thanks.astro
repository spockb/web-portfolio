---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Request received" description="Your quote request has been sent." noindex>
  <section class="page-hero">
    <div class="container page-hero__inner">
      <p class="eyebrow">Sent</p>
      <h1>Got it. Thank you.</h1>
      <p class="lede">
        Your request is in my inbox. I will reply within one business day with a quote or a couple of questions.
      </p>
      <div class="page-hero__actions">
        <a class="btn btn--primary" href="/work/">See the work</a>
        <a class="btn btn--ghost" href="/">Back to home</a>
      </div>
    </div>
  </section>
</BaseLayout>
