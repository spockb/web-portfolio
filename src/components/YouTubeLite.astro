---
// Shows only a thumbnail until clicked, then swaps in the privacy-enhanced
// YouTube player. Keeps pages fast and avoids loading YouTube up front.
interface Props {
  id: string;
  title: string;
  start?: number;
}

const { id, title, start } = Astro.props;
const params = new URLSearchParams({ autoplay: '1', rel: '0' });
if (start) params.set('start', String(start));
const embed = `https://www.youtube-nocookie.com/embed/${id}?${params}`;
const watch = `https://www.youtube.com/watch?v=${id}${start ? `&t=${start}s` : ''}`;
---

<div class="yt" data-yt data-embed={embed} data-title={title}>
  <a class="yt__link" href={watch} rel="noopener" aria-label={`Play video: ${title}`}>
    <img
      src={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`}
      srcset={`https://i.ytimg.com/vi/${id}/mqdefault.jpg 320w, https://i.ytimg.com/vi/${id}/hqdefault.jpg 480w, https://i.ytimg.com/vi/${id}/maxresdefault.jpg 1280w`}
      sizes="(min-width: 62rem) 36rem, 92vw"
      alt=""
      width="480"
      height="360"
      loading="lazy"
      decoding="async"
    />
    <span class="yt__play" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="26" height="26"><path d="M8 5.5v13l11-6.5z" fill="currentColor"></path></svg>
    </span>
  </a>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-yt]').forEach((el) => {
    const link = el.querySelector('a');
    link?.addEventListener('click', (e) => {
      if (e.metaKey || e.ctrlKey || e.shiftKey) return;
      e.preventDefault();
      const iframe = document.createElement('iframe');
      iframe.src = el.dataset.embed!;
      iframe.title = el.dataset.title!;
      iframe.allow = 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture';
      iframe.allowFullscreen = true;
      el.replaceChildren(iframe);
    });
  });
</script>

<style>
  .yt {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: #000;
  }

  .yt__link {
    display: block;
    width: 100%;
    height: 100%;
  }

  .yt img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s, opacity 0.2s;
    opacity: 0.88;
  }

  .yt__link:hover img {
    transform: scale(1.03);
    opacity: 1;
  }

  .yt__play {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 4rem;
    height: 4rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--accent);
    color: var(--accent-ink);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.5);
    transition: transform 0.15s;
  }

  .yt__play svg {
    margin-left: 3px;
  }

  .yt__link:hover .yt__play {
    transform: scale(1.08);
  }

  .yt :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
