---
import { site } from '../data/site';
import { jobs, formats } from '../data/services';
import { work } from '../data/work';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__grid">
    <div class="footer__about">
      <p class="footer__brand">{site.name} <span>{site.descriptor}</span></p>
      <p class="muted">
        Remote audio editing, repair, mixing and mastering for anything with a voice in it. Shows, podcasts, narration and
        one-off recordings.
      </p>
      <p class="mono muted">{site.location}</p>
    </div>

    <nav aria-label="Services">
      <h2 class="footer__heading">Services</h2>
      <ul class="footer__list">
        {[...jobs, ...formats].map((s) => <li><a href={`/services/${s.slug}/`}>{s.name}</a></li>)}
      </ul>
    </nav>

    <nav aria-label="Work">
      <h2 class="footer__heading">Work</h2>
      <ul class="footer__list">
        {work.map((w) => <li><a href={`/work/${w.slug}/`}>{w.title}</a></li>)}
      </ul>
    </nav>

    <nav aria-label="Company">
      <h2 class="footer__heading">Contact</h2>
      <ul class="footer__list">
        <li><a href="/contact/">Request a quote</a></li>
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        <li><a href={site.linkedin} rel="noopener me">LinkedIn</a></li>
        <li><a href="/pricing/">Pricing</a></li>
        <li><a href="/about/">About</a></li>
      </ul>
    </nav>
  </div>

  <div class="container footer__base">
    <p class="mono muted">© {year} {site.name}. All rights reserved.</p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
    background: var(--bg-raised);
    padding-block: clamp(3rem, 6vw, 4.5rem) 2rem;
    font-size: 0.9375rem;
  }

  .footer__grid {
    display: grid;
    gap: 2.5rem 2rem;
    grid-template-columns: 1fr;
  }

  .footer__about {
    display: grid;
    gap: 0.85rem;
    max-width: 24rem;
    align-content: start;
  }

  .footer__brand {
    font-family: var(--font-display);
    font-weight: 650;
    font-size: 1.25rem;
    letter-spacing: -0.02em;
  }

  .footer__brand span {
    color: var(--accent);
  }

  .footer__heading {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 1rem;
  }

  .footer__list {
    display: grid;
    gap: 0.6rem;
  }

  .footer__list a {
    color: var(--text-soft);
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .footer__list a:hover {
    color: var(--accent-strong);
  }

  .footer__base {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  @media (min-width: 40rem) {
    .footer__grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .footer__about {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 62rem) {
    .footer__grid {
      grid-template-columns: 1.6fr 1.2fr 0.8fr 1.1fr;
    }

    .footer__about {
      grid-column: auto;
    }
  }
</style>
