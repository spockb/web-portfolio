---
import type { CaseStudy } from '../data/work';

interface Props {
  item: CaseStudy;
}

const { item } = Astro.props;
const thumb = item.videos[0]?.id;
---

<a class="work card" href={`/work/${item.slug}/`}>
  {
    thumb && (
      <div class="work__thumb">
        <img
          src={`https://i.ytimg.com/vi/${thumb}/hqdefault.jpg`}
          srcset={`https://i.ytimg.com/vi/${thumb}/mqdefault.jpg 320w, https://i.ytimg.com/vi/${thumb}/maxresdefault.jpg 1280w`}
          sizes="(min-width: 62rem) 24rem, 92vw"
          alt=""
          width="480"
          height="360"
          loading="lazy"
          decoding="async"
        />
      </div>
    )
  }
  <div class="work__body">
    <p class="mono muted">{item.client}</p>
    <h3>{item.title}</h3>
    <p class="muted">{item.summary}</p>
    <ul class="tag-list">
      {item.tags.slice(0, 3).map((t) => <li class="tag">{t}</li>)}
    </ul>
    <span class="arrow-link">Read the case study</span>
  </div>
</a>

<style>
  .work {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    text-decoration: none;
    color: var(--text);
    transition: border-color 0.2s, transform 0.2s;
  }

  .work:hover {
    color: var(--text);
    border-color: var(--accent);
    transform: translateY(-3px);
  }

  .work__thumb {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #000;
    border-bottom: 1px solid var(--line);
  }

  .work__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s;
  }

  .work:hover .work__thumb img {
    transform: scale(1.04);
  }

  .work__body {
    display: grid;
    gap: 0.8rem;
    align-content: start;
    padding: clamp(1.25rem, 3vw, 1.6rem);
    flex: 1;
  }

  .work__body p.muted:not(.mono) {
    font-size: 0.975rem;
  }

  .work__body .arrow-link {
    margin-top: 0.25rem;
  }
</style>
